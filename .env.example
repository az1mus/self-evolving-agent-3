# SEA CLI — 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ── LLM 配置 ────────────────────────────────────────────────────────────────

# 模型名称（按 provider 约定填写，如 gpt-4o, claude-sonnet-4-20250514, deepseek-v4-pro）
SEA_MODEL=gpt-4o-mini

# API 密钥
SEA_API_KEY=sk-your-api-key-here

# API 端点 URL（OpenAI 兼容接口）
SEA_API_URL=https://api.openai.com/v1/chat/completions

# LLM 调用超时（秒）
SEA_TIMEOUT_SECS=60

# ── Runtime 配置 ─────────────────────────────────────────────────────────────

# 自定义 .group.toml 路径（留空则使用内嵌默认配置）
# SEA_GROUP_CONFIG=/path/to/custom.group.toml

# 开启 detailed tracing 日志
# RUST_LOG=sea=debug,info

# 日志输出文件（留空输出到 stderr）
# SEA_LOG_FILE=/tmp/sea.log

# ── Python 子进程配置 ────────────────────────────────────────────────────────

# Python 解释器路径（默认 python3 / python）
# SEA_PYTHON=python3

# 工作区目录（文件读写节点可访问的范围，默认当前目录）
# SEA_WORKSPACE_DIR=/home/user/workspace
